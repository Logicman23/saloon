// Sana's Beauty Saloon Management System — PostgreSQL / Supabase schema.
//
//   npx prisma migrate deploy     # apply prisma/migrations
//   npx prisma generate
//   npm run db:seed
//
// Conventions
//   * Tables and columns are snake_case (Postgres convention), mapped to
//     camelCase Prisma fields so application code reads naturally and raw SQL
//     needs no double-quoting.
//   * Money is Decimal(12,2), never Float, so totals cannot drift.
//   * Financial records snapshot their own totals rather than recomputing
//     from mutable relations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase pooler-friendly
}

/* ------------------------------------------------------------------ Enums */

enum StaffRole {
  OWNER
  SENIOR_STYLIST
  STYLIST
  BEAUTICIAN
  NAIL_TECHNICIAN
  MAKEUP_ARTIST
  RECEPTIONIST
}

enum ServiceCategory {
  HAIR
  SKIN
  MAKEUP
  NAILS
  SPA
}

enum ProductType {
  RETAIL
  CONSUMABLE
}

enum StockMovementType {
  STOCK_IN
  SERVICE_USAGE
  RETAIL_SALE
  DAMAGED
  EXPIRED
  ADJUSTMENT
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LineKind {
  SERVICE
  PRODUCT
  PACKAGE
}

enum DiscountKind {
  NONE
  FLAT
  PERCENT
  CODE
}

enum PaymentMode {
  CASH
  CARD
  WALLET
  TRANSFER
}

enum InvoiceStatus {
  PAID
  PARTIAL
  UNPAID
  VOID
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  UTILITIES
  PRODUCT_PURCHASE
  STAFF_SALARY
  REFRESHMENTS
  MARKETING
  MAINTENANCE
  MISCELLANEOUS
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  ACCESS_DENIED
  OVERRIDE_GRANTED
  OVERRIDE_DENIED
  ROLE_CHANGED
  PASSWORD_CHANGED
  USER_DEACTIVATED
  INVOICE_VOIDED
  DISCOUNT_OVERRIDE
  PRICE_CHANGED
  STOCK_ADJUSTED
  EXPENSE_DELETED
}

/* ------------------------------------------------- Identity & access control

   Roles are rows rather than a Prisma enum so the owner can add a role (say
   "Trainee") without a migration. The permission catalogue is seeded from
   src/lib/auth/permissions.ts, which stays the source of truth for what
   capabilities exist; these tables record which role holds which.          */

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  /// PBKDF2-HMAC-SHA512, 210k iterations. Never a plain or fast hash.
  passwordHash String @map("password_hash")
  passwordSalt String @map("password_salt")
  /// SHA-256 of the manager PIN, set only for roles that can authorise
  /// overrides. Null for everyone else.
  overridePinHash String? @map("override_pin_hash")

  active      Boolean   @default(true)
  lastLoginAt DateTime? @map("last_login_at")
  /// Rotating this invalidates every existing session for the user
  /// (password change, role change, suspected compromise).
  sessionsValidFrom DateTime  @default(now()) @map("sessions_valid_from")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  roleId String   @map("role_id")
  role   UserRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Links the login to a chair so "my schedule" and commission can scope to
  /// this person. Null for pure back-office accounts.
  staffId String? @unique @map("staff_id")
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  sessions  Session[]
  auditLogs AuditLog[]

  @@index([active])
  @@map("users")
}

model UserRole {
  id          String  @id @default(cuid())
  /// ADMIN | CASHIER | STAFF — matches the `Role` union in the app.
  key         String  @unique
  label       String
  description String?
  /// Where this role lands after sign-in.
  landingPath String  @default("/") @map("landing_path")
  /// Protects the owner role from deletion or having grants stripped.
  isSystem    Boolean @default(false) @map("is_system")

  users       User[]
  permissions RolePermission[]

  @@map("user_roles")
}

model Permission {
  /// Dotted capability key, e.g. "finance.view".
  key         String  @id
  label       String
  /// Grouping for the role editor UI: Finance, POS, Appointments, …
  category    String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

/// Explicit join so a grant can be audited and revoked individually.
model RolePermission {
  roleId        String   @map("role_id")
  permissionKey String   @map("permission_key")
  grantedAt     DateTime @default(now()) @map("granted_at")

  role       UserRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// Server-side session records.
///
/// The app issues stateless HMAC cookies; persisting sessions here is what
/// enables real revocation ("sign out everywhere", disable a leaver
/// mid-shift), which a stateless token cannot do on its own.
model Session {
  id     String @id @default(cuid())
  userId String @map("user_id")
  /// SHA-256 of the token — never the token itself, so a database leak does
  /// not hand out live sessions.
  tokenHash String @unique @map("token_hash")

  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only security and money trail. Nothing in the app updates or
/// deletes these rows; retention is handled by a scheduled job.
model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction
  userId String?     @map("user_id")
  /// Denormalised so the trail survives the user being deleted.
  actorEmail String? @map("actor_email")
  actorRole  String? @map("actor_role")
  /// Model + id the action touched, e.g. "Invoice" / "inv_0042".
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")
  /// Free-form context: amounts, before/after values, denied permission.
  metadata  Json?
  ip        String?
  userAgent String?  @map("user_agent")
  at        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([action, at])
  @@index([userId])
  @@map("audit_logs")
}

/* ----------------------------------------------------------------- People */

model Staff {
  id             String            @id @default(cuid())
  name           String
  role           StaffRole         @default(STYLIST)
  phone          String
  email          String?           @unique
  commissionRate Decimal           @default(0.10) @map("commission_rate") @db.Decimal(4, 3)
  specialties    ServiceCategory[]
  monthlySalary  Decimal           @default(0) @map("monthly_salary") @db.Decimal(12, 2)
  active         Boolean           @default(true)
  joinedAt       DateTime          @default(now()) @map("joined_at")

  appointments     Appointment[]
  invoiceLines     InvoiceLine[]
  invoicesCreated  Invoice[]       @relation("InvoiceCreatedBy")
  stockMovements   StockMovement[]
  expensesRecorded Expense[]
  /// The login attached to this chair, if any.
  user             User?

  @@index([active])
  @@map("staff")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  gender    String?
  notes     String?
  tags      String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  invoices     Invoice[]

  @@index([name])
  @@map("clients")
}

/* ------------------------------------------------------- Service catalogue */

model Service {
  id          String          @id @default(cuid())
  name        String          @map("title")
  category    ServiceCategory
  durationMin Int             @map("duration_mins")
  price       Decimal         @db.Decimal(12, 2)
  description String?
  active      Boolean         @default(true)

  packages         PackageService[]
  appointmentLinks AppointmentService[]

  @@index([category, active])
  @@map("services")
}

model ServicePackage {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  active      Boolean @default(true)

  services PackageService[]

  @@map("service_packages")
}

/// Join table so a package can bundle N services.
model PackageService {
  packageId String @map("package_id")
  serviceId String @map("service_id")

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([packageId, serviceId])
  @@map("package_services")
}

/* -------------------------------------------------------------- Inventory */

model Product {
  id                String      @id @default(cuid())
  name              String      @map("product_name")
  sku               String      @unique
  type              ProductType @default(RETAIL)
  brand             String
  unit              String      @default("pc")
  costPrice         Decimal     @map("cost_price") @db.Decimal(12, 2)
  retailPrice       Decimal     @map("retail_price") @db.Decimal(12, 2)
  stock             Int         @default(0) @map("stock_qty")
  lowStockThreshold Int         @default(5) @map("min_stock_alert")
  supplier          String?
  createdAt         DateTime    @default(now()) @map("created_at")

  movements StockMovement[]

  @@index([type])
  @@map("inventory")
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String            @map("product_id")
  type      StockMovementType
  /// Signed quantity: positive adds stock, negative consumes it.
  qty     Int
  note    String?
  staffId String?  @map("staff_id")
  at      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([productId, at])
  @@map("stock_movements")
}

/* ------------------------------------------------------------ Appointments */

model Appointment {
  id          String            @id @default(cuid())
  clientId    String            @map("client_id")
  staffId     String            @map("staff_id")
  start       DateTime          @map("scheduled_at")
  durationMin Int               @map("duration_mins")
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  client   Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff    Staff                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  services AppointmentService[]
  invoice  Invoice?

  @@index([start])
  @@index([staffId, start])
  @@index([status])
  @@map("appointments")
}

/// A booking can cover several services, which is why this is a join rather
/// than a single service_id column on `appointments`.
model AppointmentService {
  appointmentId String @map("appointment_id")
  serviceId     String @map("service_id")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

/* ---------------------------------------------------------------- Billing */

/// `total_amount`, `paid_amount` and the revenue split are snapshots written
/// at checkout, not derived on read. A finalised bill is an immutable
/// financial record: if a service price changes next month, last month's
/// invoice must not silently change with it. `invoice_lines` remains the
/// audit detail, and the denormalised split lets the dashboard aggregate
/// without walking every line on every request.
model Invoice {
  id            String  @id @default(cuid())
  number        String  @unique
  clientId      String  @map("client_id")
  appointmentId String? @unique @map("appointment_id")

  discountKind  DiscountKind @default(NONE) @map("discount_kind")
  discountValue Decimal      @default(0) @map("discount_value") @db.Decimal(12, 2)
  discountCode  String?      @map("discount_code")
  taxRate       Decimal      @default(0) @map("tax_rate") @db.Decimal(5, 2)

  totalAmount     Decimal @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount      Decimal @default(0) @map("paid_amount") @db.Decimal(12, 2)
  serviceRevenue  Decimal @default(0) @map("service_revenue") @db.Decimal(12, 2)
  retailRevenue   Decimal @default(0) @map("retail_revenue") @db.Decimal(12, 2)
  commissionTotal Decimal @default(0) @map("commission_total") @db.Decimal(12, 2)

  status InvoiceStatus @default(UNPAID) @map("payment_status")
  note   String?

  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy   Staff         @relation("InvoiceCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  lines       InvoiceLine[]
  payments    Payment[]

  @@index([createdAt])
  @@index([status])
  @@index([clientId])
  @@map("sales_invoices")
}

model InvoiceLine {
  id        String   @id @default(cuid())
  invoiceId String   @map("invoice_id")
  kind      LineKind
  /// Id of the source Service / Product / ServicePackage row.
  refId     String   @map("ref_id")
  /// Denormalised so historical invoices survive catalogue renames.
  name      String
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  qty       Int      @default(1)
  /// Per-line staff attribution — drives the commission report.
  staffId String? @map("staff_id")
  /// Snapshot of the rate at sale time.
  commissionRate Decimal @default(0) @map("commission_rate") @db.Decimal(4, 3)
  lineDiscount   Decimal @default(0) @map("line_discount") @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([staffId])
  @@map("invoice_lines")
}

model Payment {
  id        String      @id @default(cuid())
  invoiceId String      @map("invoice_id")
  mode      PaymentMode @map("payment_method")
  amount    Decimal     @db.Decimal(12, 2)
  reference String?
  at        DateTime    @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

model PromoCode {
  code      String       @id
  label     String
  kind      DiscountKind @default(PERCENT)
  value     Decimal      @db.Decimal(12, 2)
  minSpend  Decimal      @default(0) @map("min_spend") @db.Decimal(12, 2)
  active    Boolean      @default(true)
  expiresAt DateTime?    @map("expires_at")

  @@map("promo_codes")
}

/* --------------------------------------------------------------- Expenses */

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @map("expense_date")
  vendor      String?
  note        String?
  paymentMode PaymentMode     @default(CASH) @map("payment_method")
  /// Storage key / filename of the uploaded receipt.
  attachment        String?
  recordedByStaffId String   @map("recorded_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")

  recordedBy Staff @relation(fields: [recordedByStaffId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([category])
  @@map("expenses")
}
