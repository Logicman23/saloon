// Sana's Beauty Saloon Management System — PostgreSQL / Supabase schema.
//
//   npx prisma migrate dev --name init
//   npx prisma generate
//
// Money is stored as Decimal(12,2) rather than Float so totals never drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase pooler-friendly
}

/**
 * ------------------------------------------------------------------ Enums
 */

enum StaffRole {
  OWNER
  SENIOR_STYLIST
  STYLIST
  BEAUTICIAN
  NAIL_TECHNICIAN
  MAKEUP_ARTIST
  RECEPTIONIST
}

enum ServiceCategory {
  HAIR
  SKIN
  MAKEUP
  NAILS
  SPA
}

enum ProductType {
  RETAIL
  CONSUMABLE
}

enum StockMovementType {
  STOCK_IN
  SERVICE_USAGE
  RETAIL_SALE
  DAMAGED
  EXPIRED
  ADJUSTMENT
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LineKind {
  SERVICE
  PRODUCT
  PACKAGE
}

enum DiscountKind {
  NONE
  FLAT
  PERCENT
  CODE
}

enum PaymentMode {
  CASH
  CARD
  WALLET
  TRANSFER
}

enum InvoiceStatus {
  PAID
  PARTIAL
  UNPAID
  VOID
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  UTILITIES
  PRODUCT_PURCHASE
  STAFF_SALARY
  REFRESHMENTS
  MARKETING
  MAINTENANCE
  MISCELLANEOUS
}

/**
 * ------------------------------------------------- Identity & access control
 * Roles are rows rather than a Prisma enum so the owner can add a role (say
 * "Trainee") without a migration. Permissions are seeded from
 * src/lib/auth/permissions.ts — that file stays the source of truth for the
 * catalogue*; this schema stores which role holds which grant.
 */

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  /// PBKDF2-HMAC-SHA512, 210k iterations. Never a plain or fast hash.
  passwordHash      String
  passwordSalt      String
  /// SHA-256 of the manager PIN, set only for roles that can authorise
  /// overrides. Null for everyone else.
  overridePinHash   String?
  active            Boolean   @default(true)
  lastLoginAt       DateTime?
  /// Forces re-authentication everywhere when rotated (password change,
  /// role change, suspected compromise): compare against the session's iat.
  sessionsValidFrom DateTime  @default(now())
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  roleId String
  role   UserRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Links the login to a chair so "my schedule" and commission can scope
  /// to this person. Null for pure back-office accounts.
  staffId String? @unique
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  sessions  Session[]
  auditLogs AuditLog[]

  @@index([active])
  @@map("users")
}

model UserRole {
  id          String  @id @default(cuid())
  /// ADMIN | CASHIER | STAFF — matches the `Role` union in the app.
  key         String  @unique
  label       String
  description String?
  /// Where this role lands after sign-in.
  landingPath String  @default("/")
  /// Protects the owner role from being deleted or stripped of grants.
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  @@map("user_roles")
}

model Permission {
  /// Dotted capability key, e.g. "finance.view".
  key         String  @id
  label       String
  /// Grouping for the role editor UI: Finance, POS, Appointments, …
  category    String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

/// Explicit join so a grant can be audited and revoked individually.
model RolePermission {
  roleId        String
  permissionKey String
  grantedAt     DateTime @default(now())

  role       UserRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// Server-side session records.
///
/// The app currently issues stateless HMAC cookies; persisting sessions here
/// is what enables real revocation ("sign out everywhere", disable a leaver
/// mid-shift), which a stateless token cannot do on its own.
model Session {
  id         String    @id @default(cuid())
  userId     String
  /// SHA-256 of the token — never the token itself, so a database leak does
  /// not hand out live sessions.
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  ACCESS_DENIED
  OVERRIDE_GRANTED
  OVERRIDE_DENIED
  ROLE_CHANGED
  PASSWORD_CHANGED
  USER_DEACTIVATED
  INVOICE_VOIDED
  DISCOUNT_OVERRIDE
  PRICE_CHANGED
  STOCK_ADJUSTED
  EXPENSE_DELETED
}

/// Append-only security and money trail. Nothing in the app updates or
/// deletes these rows; retention is handled by a scheduled job.
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  userId     String?
  /// Denormalised so the trail survives the user being deleted.
  actorEmail String?
  actorRole  String?
  /// Model + id the action touched, e.g. "Invoice" / "inv_0042".
  entityType String?
  entityId   String?
  /// Free-form context: amounts, before/after values, denied permission.
  metadata   Json?
  ip         String?
  userAgent  String?
  at         DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([action, at])
  @@index([userId])
  @@map("audit_logs")
}

/**
 * ----------------------------------------------------------------- People
 */

model Staff {
  id             String            @id @default(cuid())
  name           String
  role           StaffRole         @default(STYLIST)
  phone          String
  email          String?           @unique
  commissionRate Decimal           @default(0.10) @db.Decimal(4, 3)
  specialties    ServiceCategory[]
  monthlySalary  Decimal           @default(0) @db.Decimal(12, 2)
  active         Boolean           @default(true)
  joinedAt       DateTime          @default(now())

  appointments     Appointment[]
  invoiceLines     InvoiceLine[]
  invoicesCreated  Invoice[]       @relation("InvoiceCreatedBy")
  stockMovements   StockMovement[]
  expensesRecorded Expense[]
  /// The login attached to this chair, if any.
  user             User?

  @@index([active])
  @@map("staff")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  gender    String?
  notes     String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  invoices     Invoice[]

  @@index([name])
  @@map("clients")
}

/**
 * ------------------------------------------------------- Service catalogue
 */

model Service {
  id          String          @id @default(cuid())
  name        String
  category    ServiceCategory
  durationMin Int
  price       Decimal         @db.Decimal(12, 2)
  description String?
  active      Boolean         @default(true)

  packages         PackageService[]
  appointmentLinks AppointmentService[]

  @@index([category, active])
  @@map("services")
}

model ServicePackage {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  active      Boolean @default(true)

  services PackageService[]

  @@map("service_packages")
}

/// Join table so a package can bundle N services.
model PackageService {
  packageId String
  serviceId String

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([packageId, serviceId])
  @@map("package_services")
}

/**
 * -------------------------------------------------------------- Inventory
 */

model Product {
  id                String      @id @default(cuid())
  name              String
  sku               String      @unique
  type              ProductType @default(RETAIL)
  brand             String
  unit              String      @default("pc")
  costPrice         Decimal     @db.Decimal(12, 2)
  retailPrice       Decimal     @db.Decimal(12, 2)
  stock             Int         @default(0)
  lowStockThreshold Int         @default(5)
  supplier          String?
  createdAt         DateTime    @default(now())

  movements StockMovement[]

  @@index([type])
  @@map("products")
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  type      StockMovementType
  /// Signed quantity: positive adds stock, negative consumes it.
  qty       Int
  note      String?
  staffId   String?
  at        DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([productId, at])
  @@map("stock_movements")
}

/**
 * ------------------------------------------------------------ Appointments
 */

model Appointment {
  id          String            @id @default(cuid())
  clientId    String
  staffId     String
  start       DateTime
  durationMin Int
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  client   Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff    Staff                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  services AppointmentService[]
  invoice  Invoice?

  @@index([start])
  @@index([staffId, start])
  @@index([status])
  @@map("appointments")
}

model AppointmentService {
  appointmentId String
  serviceId     String

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

/**
 * ---------------------------------------------------------------- Billing
 */

model Invoice {
  id               String        @id @default(cuid())
  number           String        @unique
  clientId         String
  appointmentId    String?       @unique
  discountKind     DiscountKind  @default(NONE)
  discountValue    Decimal       @default(0) @db.Decimal(12, 2)
  discountCode     String?
  taxRate          Decimal       @default(0) @db.Decimal(5, 2)
  status           InvoiceStatus @default(UNPAID)
  note             String?
  createdByStaffId String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy   Staff         @relation("InvoiceCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  lines       InvoiceLine[]
  payments    Payment[]

  @@index([createdAt])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  kind           LineKind
  /// Id of the source Service / Product / ServicePackage row.
  refId          String
  /// Denormalised so historical invoices survive catalogue renames.
  name           String
  unitPrice      Decimal  @db.Decimal(12, 2)
  qty            Int      @default(1)
  /// Per-line staff attribution — drives the commission report.
  staffId        String?
  /// Snapshot of the rate at sale time.
  commissionRate Decimal  @default(0) @db.Decimal(4, 3)
  lineDiscount   Decimal  @default(0) @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([staffId])
  @@map("invoice_lines")
}

model Payment {
  id        String      @id @default(cuid())
  invoiceId String
  mode      PaymentMode
  amount    Decimal     @db.Decimal(12, 2)
  reference String?
  at        DateTime    @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

model PromoCode {
  code      String       @id
  label     String
  kind      DiscountKind @default(PERCENT)
  value     Decimal      @db.Decimal(12, 2)
  minSpend  Decimal      @default(0) @db.Decimal(12, 2)
  active    Boolean      @default(true)
  expiresAt DateTime?

  @@map("promo_codes")
}

/**
 * --------------------------------------------------------------- Expenses
 */

model Expense {
  id                String          @id @default(cuid())
  category          ExpenseCategory
  amount            Decimal         @db.Decimal(12, 2)
  date              DateTime
  vendor            String?
  note              String?
  paymentMode       PaymentMode     @default(CASH)
  /// Storage key / filename of the uploaded receipt.
  attachment        String?
  recordedByStaffId String
  createdAt         DateTime        @default(now())

  recordedBy Staff @relation(fields: [recordedByStaffId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([category])
  @@map("expenses")
}
