# Copy to .env and fill in before running Prisma.
#
# Supabase: Project Settings -> Database -> Connection string
#   DATABASE_URL  = the pooled (pgbouncer, port 6543) connection — used at runtime
#   DIRECT_URL    = the direct (port 5432) connection — used for migrations

DATABASE_URL="postgresql://postgres:password@localhost:5432/sanas_salon?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/sanas_salon?schema=public"

# ---------------------------------------------------------------- Auth ----
# Signs the session cookie. MUST be at least 32 characters; the app refuses
# to start in production without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Manager PIN a cashier must enter for discount overrides and invoice voids.
# Required in production.
ADMIN_OVERRIDE_PIN=""

# Consumed by prisma/seed-rbac.ts when creating the first owner account.
OWNER_EMAIL="owner@sanasbeauty.pk"
OWNER_PASSWORD=""
